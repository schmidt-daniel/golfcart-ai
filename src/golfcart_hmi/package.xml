<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>golfcart_hmi</name>
  <version>0.1.0</version>
  <description>Handle-unit HMI: ESP32 firmware (LVGL) + Pi-side serial gateway.</description>
  <maintainer email="dev@example.com">golfcart</maintainer>
