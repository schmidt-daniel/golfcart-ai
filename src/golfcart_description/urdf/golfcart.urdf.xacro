<?xml version="1.0"?>
<!--
  Generic 3-wheeled golf push trolley URDF (xacro).

  Kinematics:
    - Two rear wheels (fixed, non-steering), driven by the ODrive.
    - One front wheel (caster-like, rotates on a vertical axis to steer).

  Sensor mounts:
    - LiDAR, camera, IMU, GPS are mounted ABOVE the front wheel,
      on a mast/column rising from the front wheel area.

  All dimensions are xacro parameters — edit them with the correct measurements later.
  Frames follow REP-103 (X forward, Y left, Z up) and the architecture's
  frame tree: base_link -> {lidar_link, camera_link, imu_link, gps_link}.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="golfcart">

  <!-- ===================== Parameters (edit these) ===================== -->
  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.9"/>   <!-- m, front-to-back -->
  <xacro:property name="chassis_width"  value="0.6"/>   <!-- m, side-to-side -->
  <xacro:property name="chassis_height" value="0.15"/>  <!-- m, thickness -->
  <xacro:property name="chassis_z"       value="0.35"/>   <!-- m, height of chassis above ground -->

  <!-- Rear wheels (driven) -->
  <xacro:property name="rear_wheel_radius" value="0.15"/> <!-- m -->
  <xacro:property name="rear_wheel_width"  value="0.05"/> <!-- m -->
  <xacro:property name="rear_wheel_base"   value="0.5"/>  <!-- m, distance between rear wheels (track) -->
  <xacro:property name="rear_axle_x"       value="-0.25"/> <!-- m, rear axle position along X (behind center) -->

  <!-- Front wheel (steering caster) -->
  <xacro:property name="front_wheel_radius" value="0.12"/> <!-- m -->
  <xacro:property name="front_wheel_width"  value="0.04"/> <!-- m -->
  <xacro:property name="front_wheel_x"       value="0.35"/>  <!-- m, front wheel position along X (ahead of center) -->
  <xacro:property name="front_wheel_y"       value="0.0"/>   <!-- m, centered -->

  <!-- Mast / sensor column (above front wheel) -->
  <xacro:property name="mast_x" value="0.35"/>  <!-- m, same X as front wheel -->
  <xacro:property name="mast_y" value="0.0"/>   <!-- m, centered -->
  <xacro:property name="mast_z" value="0.6"/>   <!-- m, height of sensor platform above ground -->

  <!-- Sensor offsets (relative to mast top; edit with measured values) -->
  <xacro:property name="lidar_offset_z"  value="0.05"/>  <!-- m, above mast top -->
  <xacro:property name="camera_offset_z" value="0.02"/>  <!-- m, above mast top -->
  <xacro:property name="imu_offset_z"    value="0.0"/>   <!-- m, at mast top -->
  <xacro:property name="gps_offset_z"    value="0.10"/>  <!-- m, above mast top -->

  <!-- ===================== Materials ===================== -->
  <material name="chassis_mat">
    <color rgba="0.2 0.3 0.4 1.0"/>
  </material>
  <material name="wheel_mat">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="mast_mat">
    <color rgba="0.4 0.4 0.45 1.0"/>
  </material>
  <material name="sensor_mat">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <!-- ===================== Base link (chassis) ===================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <material name="chassis_mat"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- ===================== Rear wheels (driven, fixed) ===================== -->
  <!-- Left rear wheel -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${rear_wheel_radius}" length="${rear_wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${rear_wheel_radius}" length="${rear_wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="${rear_axle_x} ${rear_wheel_base/2} ${rear_wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right rear wheel -->
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${rear_wheel_radius}" length="${rear_wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${rear_wheel_radius}" length="${rear_wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="${rear_axle_x} ${-rear_wheel_base/2} ${rear_wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================== Front wheel (steering caster) ===================== -->
  <!-- Steering column: rotates on the vertical (Z) axis. -->
  <link name="front_steer">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.15"/>
      </geometry>
      <origin xyz="0 0 ${front_wheel_radius}" rpy="0 0 0"/>
      <material name="mast_mat"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.15"/>
      </geometry>
      <origin xyz="0 0 ${front_wheel_radius}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_steer_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_steer"/>
    <origin xyz="${front_wheel_x} ${front_wheel_y} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>  <!-- rotates on vertical axis to steer -->
  </joint>

  <!-- Front wheel itself (spins on its own horizontal axis) -->
  <link name="front_wheel">
    <visual>
      <geometry>
        <cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="front_wheel_joint" type="continuous">
    <parent link="front_steer"/>
    <child link="front_wheel"/>
    <origin xyz="0 0 ${front_wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>  <!-- spins on its own horizontal axis -->
  </joint>

  <!-- ===================== Mast / sensor column (above front wheel) ===================== -->
  <link name="mast">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="${mast_z - front_wheel_radius}"/>
      </geometry>
      <origin xyz="0 0 ${(mast_z + front_wheel_radius)/2}" rpy="0 0 0"/>
      <material name="mast_mat"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="${mast_z - front_wheel_radius}"/>
      </geometry>
      <origin xyz="0 0 ${(mast_z + front_wheel_radius)/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Mast is fixed to the chassis (does not rotate with the front wheel). -->
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="${mast_x} ${mast_y} 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Sensors (above mast top) ===================== -->
  <!-- LiDAR -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="sensor_mat"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="mast"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${mast_z + lidar_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.03 0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="sensor_mat"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.03 0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="mast"/>
    <child link="camera_link"/>
    <origin xyz="0 0 ${mast_z + camera_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="sensor_mat"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="mast"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${mast_z + imu_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- GPS -->
  <link name="gps_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.01"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="sensor_mat"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.01"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="mast"/>
    <child link="gps_link"/>
    <origin xyz="0 0 ${mast_z + gps_offset_z}" rpy="0 0 0"/>
  </joint>

</robot>